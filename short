param(
    [Parameter(Mandatory = $true)]
    [string[]]$HarFiles,

    [string]$OutputHar = '',

    [switch]$PassThru
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function New-DefaultCreator {
    [pscustomobject]@{
        name    = 'PowerShell HAR Merger'
        version = '1.0'
    }
}

if (-not $HarFiles -or $HarFiles.Count -eq 0) {
    throw 'At least one HAR file is required.'
}

$resolvedFiles = @()
foreach ($harFile in $HarFiles) {
    if (-not (Test-Path -LiteralPath $harFile)) {
        throw "HAR file not found: $harFile"
    }

    $resolvedFiles += (Resolve-Path -LiteralPath $harFile).Path
}

if (-not $OutputHar) {
    $OutputHar = Join-Path (Get-Location) 'combined.har'
}

$outputPath = [System.IO.Path]::GetFullPath($OutputHar)
$outputDir = Split-Path -Parent $outputPath
if ($outputDir -and -not (Test-Path -LiteralPath $outputDir)) {
    New-Item -ItemType Directory -Path $outputDir -Force | Out-Null
}

$mergedEntries = [System.Collections.Generic.List[object]]::new()
$mergedPages = [System.Collections.Generic.List[object]]::new()
$comments = [System.Collections.Generic.List[string]]::new()
$firstLog = $null
$version = '1.2'
$creator = $null
$browser = $null

function Get-LogPropertyValue {
    param(
        [Parameter(Mandatory = $true)]$Object,
        [Parameter(Mandatory = $true)][string]$PropertyName
    )

    if ($null -eq $Object) { return $null }
    if ($Object.PSObject.Properties.Name -contains $PropertyName) {
        return $Object.$PropertyName
    }

    return $null
}

foreach ($file in $resolvedFiles) {
    try {
        $har = Get-Content -LiteralPath $file -Raw | ConvertFrom-Json
    }
    catch {
        throw "Unable to parse HAR file '$file': $($_.Exception.Message)"
    }

    $log = $har.log
    if (-not $log) {
        throw "HAR file does not contain a log object: $file"
    }

    if (-not $firstLog) {
        $firstLog = $log
        $version = [string](Get-LogPropertyValue -Object $firstLog -PropertyName 'version')
        if ($null -eq $version -or [string]::IsNullOrWhiteSpace([string]$version)) {
            $version = '1.2'
        }
        $creator = Get-LogPropertyValue -Object $firstLog -PropertyName 'creator'
        $browser = Get-LogPropertyValue -Object $firstLog -PropertyName 'browser'
    }

    $entries = Get-LogPropertyValue -Object $log -PropertyName 'entries'
    if ($entries) {
        foreach ($entry in @($entries)) {
            $null = $mergedEntries.Add($entry)
        }
    }

    $pages = Get-LogPropertyValue -Object $log -PropertyName 'pages'
    if ($pages) {
        foreach ($page in @($pages)) {
            $null = $mergedPages.Add($page)
        }
    }

    $comment = Get-LogPropertyValue -Object $log -PropertyName 'comment'
    if ($comment) {
        $null = $comments.Add([string]$comment)
    }
}

if (-not $creator) {
    $creator = New-DefaultCreator
}

$commentText = if ($comments.Count -gt 0) {
    "Combined from $($resolvedFiles.Count) HAR file(s). $($comments -join ' | ')"
}
else {
    "Combined from $($resolvedFiles.Count) HAR file(s)."
}

$mergedHar = [pscustomobject]@{
    log = [pscustomobject]@{
        version = $version
        creator = $creator
        browser = $browser
        pages   = @($mergedPages)
        entries = @($mergedEntries)
        comment = $commentText
    }
}

$mergedHar | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $outputPath -Encoding UTF8

Write-Host "Created $outputPath with $($mergedEntries.Count) entries from $($resolvedFiles.Count) HAR file(s)."

if ($PassThru) {
    return $mergedHar
}
