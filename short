param(
    [Parameter(Mandatory)]
    [string]$EnvironmentUrl,

    [Parameter(Mandatory)]
    [string]$TenantId,

    [Parameter(Mandatory)]
    [string]$ClientId,

    [Parameter(Mandatory)]
    [string]$EntityPath,

    [string]$QueryString = '$select=cr9da_firstname,cr9da_lastname&$orderby=createdon desc&$top=5000&$count=true'
)

$ErrorActionPreference = 'Stop'

$scope = $EnvironmentUrl.TrimEnd('/') + '/.default'

$deviceResponse = Invoke-RestMethod -Method Post -Uri "https://login.microsoftonline.com/$TenantId/oauth2/v2.0/devicecode" -Body @{ client_id = $ClientId; scope = $scope } -ContentType 'application/x-www-form-urlencoded'
Write-Host $deviceResponse.message
Write-Host ''

$tokenBody = @{ grant_type = 'urn:ietf:params:oauth:grant-type:device_code'; client_id = $ClientId; device_code = $deviceResponse.device_code }

$accessToken = $null
$interval = [int]$deviceResponse.interval
while ($null -eq $accessToken) {
    Start-Sleep -Seconds $interval
    try {
        $tokenResponse = Invoke-RestMethod -Method Post -Uri "https://login.microsoftonline.com/$TenantId/oauth2/v2.0/token" -Body $tokenBody -ContentType 'application/x-www-form-urlencoded' -ErrorAction Stop
        $accessToken = $tokenResponse.access_token
    }
    catch {
        $err = ($_.ErrorDetails.Message | ConvertFrom-Json -ErrorAction SilentlyContinue).error
        if ($err -eq 'authorization_pending') { continue }
        elseif ($err -eq 'slow_down') { $interval += 5; continue }
        elseif ($err -eq 'authorization_declined') { throw 'Login was declined.' }
        elseif ($err -eq 'expired_token') { throw 'Device code expired.' }
        else { throw $_ }
    }
}

$baseUrl = $EnvironmentUrl.TrimEnd('/')
$nextUrl = $baseUrl + '/api/data/v9.0/' + $EntityPath + '?' + $QueryString
$totalRows = 0
$page = 1
$lastResponse = $null
$headers = @{ Authorization = 'Bearer ' + $accessToken; Accept = 'application/json' }

while ($nextUrl) {
    Write-Host ('Fetching page ' + $page + ': ' + $nextUrl)
    $responseText = Invoke-WebRequest -Method Get -Uri $nextUrl -Headers $headers | Select-Object -ExpandProperty Content
    $jsonObject = $responseText | ConvertFrom-Json

    $lastResponse = @{}
    foreach ($prop in $jsonObject.PSObject.Properties) {
        $lastResponse[$prop.Name] = $prop.Value
    }

    if ($lastResponse.ContainsKey('value')) {
        $totalRows += @($lastResponse['value']).Count
    }

    $nextLink = $null
    if ($lastResponse.ContainsKey('@odata.nextLink')) {
        $nextLink = $lastResponse['@odata.nextLink']
    }

    if ($nextLink) {
        $nextUrl = $nextLink
    }
    else {
        $nextUrl = $null
    }

    $page++
}

Write-Host ('Total rows fetched: ' + $totalRows)
if ($lastResponse) {
    $odataCount = $null
    if ($lastResponse.ContainsKey('@odata.count')) {
        $odataCount = $lastResponse['@odata.count']
    }

    $crmTotalCount = $null
    if ($lastResponse.ContainsKey('@Microsoft.Dynamics.CRM.totalrecordcount')) {
        $crmTotalCount = $lastResponse['@Microsoft.Dynamics.CRM.totalrecordcount']
    }

    Write-Host ('OData count: ' + $odataCount)
    Write-Host ('CRM total record count: ' + $crmTotalCount)
}
