$harFile = "powerapp_load.har"
$outputFile = "all_raw_batch_requests.txt"

# Read and parse the HAR JSON file
$har = Get-Content -Raw -Encoding UTF8 $harFile | ConvertFrom-Json
$entries = $har.log.entries
$batchCount = 0

# Create or clear the output file
Set-Content -Path $outputFile -Value $null

foreach ($entry in $entries) {
    # Check if URL contains $batch (single quotes prevent PowerShell from treating $ as a variable)
    if ($entry.request.url -like '*$batch*') {
        $rawBody = $entry.request.postData.text
        
        if ($rawBody) {
            $batchCount++
            
            # Construct the visual delimiters
            $delimiter = "========================================`n" +
                         "=== BATCH REQUEST #$batchCount ===`n" +
                         "========================================`n`n"
            
            # Append the delimiter and raw payload to the single file
            Add-Content -Path $outputFile -Value $delimiter
            Add-Content -Path $outputFile -Value $rawBody
            Add-Content -Path $outputFile -Value "`n`n`n"
        }
    }
}

Write-Host "Success! Extracted $batchCount raw `$batch payloads into '$outputFile'."
