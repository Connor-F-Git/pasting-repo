import json

# Config
har_filename = 'powerapp_load.har'
output_filename = 'all_raw_batch_requests.txt'

with open(har_filename, 'r', encoding='utf-8') as f:
    har_data = json.load(f)

entries = har_data.get('log', {}).get('entries', [])
batch_count = 0

with open(output_filename, 'w', encoding='utf-8') as out_file:
    for entry in entries:
        request = entry.get('request', {})
        url = request.get('url', '')
        
        # Target only the $batch network flights
        if '$batch' in url:
            post_data = request.get('postData', {})
            raw_body = post_data.get('text', '')
            
            if raw_body:
                batch_count += 1
                
                # Visual delimiter for the single file
                out_file.write(f"========================================\n")
                out_file.write(f"=== BATCH REQUEST #{batch_count} ===\n")
                out_file.write(f"========================================\n\n")
                
                # Write the 100% raw unaltered payload body
                out_file.write(raw_body)
                
                # Space out the next request
                out_file.write("\n\n\n")

print(f"Success! Extracted {batch_count} raw $batch payloads into '{output_filename}'.")========================================
